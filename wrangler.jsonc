{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "didi-dash",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "didi-dash",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ]
}
