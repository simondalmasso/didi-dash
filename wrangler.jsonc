{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "didi-dash",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "DATA",
      "id": "b77c75547dcc4d0bbc7d6928de0fcf9b"
    }
  ]
}
